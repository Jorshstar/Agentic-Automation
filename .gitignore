# Dependencies
node_modules/

# Secrets — NEVER commit these
.env
.env.local
.env.*.local
# Any other .env variant — including timestamped backups, which hold live keys.
# .env.example is the documented template and is deliberately kept.
.env.*
!.env.example

# Trigger.dev local artifacts
.trigger/

# Build output
dist/
build/

# Generated video packages (storage step, later)
output/

# Logs
*.log
npm-debug.log*

# Scratch command-output dumps (ffmpeg/ffprobe debugging, etc.)
/*.txt

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Supervisor logs from scripts/studio-autostart.*
logs/

# Watch folder for drag-and-drop clipping
input/

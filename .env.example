# =============================================================================
# .env.example — template for environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env        (Mac/Linux)
#     copy .env.example .env      (Windows cmd)
#
# NEVER commit the real `.env` (it is already in .gitignore). When you add a new
# secret here, also add it in the Trigger.dev dashboard → your project →
# Environment Variables (staging AND prod), or production runs will fail.
# =============================================================================

# --- App settings (non-secret, have safe defaults — optional) -----------------
# IANA timezone used for date math + scheduling. Defaults to UTC.
# STUDIO_TIMEZONE=America/New_York
# Local folder where finished video packages will be written (storage step).
# STUDIO_OUTPUT_DIR=./output

# --- Future integrations (NOT used yet — added in later steps) -----------------
# Anthropic Claude (Provider SDK Layer — used by `npm run demo:claude`):
ANTHROPIC_API_KEY=                 # from https://console.anthropic.com/  (never commit the real key)

# OpenAI — Voice Generation (TTS) AND Visuals (AI images). Required for those
# production stages. Get a key at https://platform.openai.com/api-keys (paid,
# usage-based; a 60s video's audio + images cost a few cents). Never commit it.
OPENAI_API_KEY=
#
# Storage (Google Drive):
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Delivery (Telegram) — the daily bot DMs you the finished MP4 + caption.
#   1. In Telegram, message @BotFather → /newbot → copy the token below.
#   2. Message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy your chat id.
TELEGRAM_BOT_TOKEN=                # from @BotFather on Telegram
TELEGRAM_CHAT_ID=                  # your chat id (see getUpdates)

# Real stock footage (Pexels + Pixabay) — OPTIONAL, FREE, and recommended.
# When set, each scene tries to use a real vertical video clip (Pexels first,
# then Pixabay) and only falls back to a paid AI image when neither has a good
# match — so videos get real motion AND cost less. With NEITHER key set, the
# studio silently uses AI images for every scene (exactly as before).
#   Pexels:  https://www.pexels.com/api/  → "Get Started" → copy your API key (free)
#   Pixabay: https://pixabay.com/api/docs/ → log in → your key is shown (free)
PEXELS_API_KEY=                    # free from https://www.pexels.com/api/
PIXABAY_API_KEY=                   # free from https://pixabay.com/api/docs/

# Topic memory (never repeat a topic) — OPTIONAL but REQUIRED for the cloud.
# Without these, memory uses a local JSON file (fine for local runs, but wiped on
# Trigger.dev's cloud). For hands-off cloud runs, create a free Upstash Redis DB
# (https://console.upstash.com → Redis → REST API) and paste both values here AND
# in the Trigger.dev dashboard env vars.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
